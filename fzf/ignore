# Paths hidden from every fzf picker (shell Ctrl-T / Alt-C / vf / fcd and
# Rex's rex-find). fd reads this via --ignore-file, in .gitignore syntax:
# a trailing slash matches directories only. .gitignore itself is NOT
# honoured (--no-ignore-vcs), so gitignored files such as .env stay findable.
# Keep in sync with the nvim repo's lua/config/plugins/telescope.lua.

