#!/usr/bin/env bash
# rex-find: fuzzy-pick a file in the current directory and open it in an editor.
# Editor comes from REX_PICKER_EDITOR (e.g. "nvim", "code -g"); defaults to nvim.
set -euo pipefail

editor="${REX_PICKER_EDITOR:-nvim}"

# Show gitignored files too; hide only what the repo's fzf/ignore lists.
# This script is symlinked into ~/.local/bin, so resolve the link first.
self="$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")"
ignore_file="$(cd "$(dirname "${self}")/.." && pwd)/fzf/ignore"

file=$(fd --type f --hidden --no-ignore-vcs --ignore-file "${ignore_file}" \
  | fzf --preview 'head -100 {}' --height 100% --reverse) || exit 0

[[ -z "$file" ]] && exit 0

# $editor unquoted on purpose: "code -g" must split into program + flag.
# exec replaces this script, so nvim owns the terminal directly.
exec $editor "$file"
